# SRE Environment Configuration

# Sandbox mode: "local" (default) or "hf"
# - local: Docker containers with SSH (training on desktop)
# - hf: subprocess-based in-container execution (HF Spaces deployment)
SANDBOX_MODE=local

# OpenRouter API key (if using OpenRouter for LLM inference)
# OPENROUTER_API_KEY=sk-or-v1-...
