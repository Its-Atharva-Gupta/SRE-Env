# SRE Environment Configuration

# Sandbox mode: "local" (default) or "remote"
# - local: Use Docker directly (desktop/VPS with Docker daemon)
# - remote: Use remote sandbox manager API (HF Spaces, etc.)
SANDBOX_MODE=local

# Remote sandbox manager URL (only needed if SANDBOX_MODE=remote)
# This should point to the machine running sandbox/manager.py
SANDBOX_MANAGER_URL=http://localhost:9000

# OpenRouter API key (if using OpenRouter for LLM inference)
# OPENROUTER_API_KEY=sk-or-v1-...
